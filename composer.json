{
  "name": "ayangzy/laravel-sales-commission",
  "description": "A comprehensive sales commission calculation and management package for Laravel",
  "keywords": [
    "laravel",
    "commission",
    "sales",
    "saas",
    "payout",
    "earnings"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Ayangzy",
      "email": "ayangefelix8@gmail.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "illuminate/contracts": "^10.0|^11.0",
    "illuminate/database": "^10.0|^11.0",
    "illuminate/support": "^10.0|^11.0"
  },
  "require-dev": {
    "orchestra/testbench": "^8.0|^9.0",
    "phpunit/phpunit": "^10.0|^11.0"
  },
  "autoload": {
    "psr-4": {
      "SalesCommission\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SalesCommission\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "SalesCommission\\SalesCommissionServiceProvider"
      ],
      "aliases": {
        "Commission": "SalesCommission\\Facades\\Commission"
      }
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "vendor/bin/phpunit",
    "test-coverage": "XDEBUG_MODE=coverage vendor/bin/phpunit --coverage-text"
  },
  "support": {
    "issues": "https://github.com/ayangzy/laravel-sales-commission/issues",
    "source": "https://github.com/ayangzy/laravel-sales-commission"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
